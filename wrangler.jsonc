{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerberus-workspace",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cerberus-workspace",
    "database_id": "6aac7050-c5a2-49c8-90f2-840920ea58bf",
    "migrations_dir": "db/migrations"
  }],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://cerberus-workspace.mosthistory139.workers.dev"
  },
  "observability": { "enabled": true }
}
